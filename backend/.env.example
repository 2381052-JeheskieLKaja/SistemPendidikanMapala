# Salin menjadi .env lalu isi nilai sesuai MySQL lokal Anda. Jangan commit file .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mapala
DB_PASSWORD=isi_password_mysql
DB_NAME=mapala_pendidikan
# Database terpisah khusus pengujian otomatis (npm test). Isinya dihapus setiap test dijalankan.
DB_TEST_NAME=mapala_pendidikan_test
# String acak panjang, mis. hasil: openssl rand -hex 48
JWT_SECRET=isi_string_acak_panjang
JWT_EXPIRES_IN=8h
PORT=4100
CORS_ORIGIN=http://localhost:5180
