{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/app.js",
      "installCommand": "npm install --workspaces=false",
      "buildCommand": "npm run db:reset"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm install --workspaces=false --include=optional",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
